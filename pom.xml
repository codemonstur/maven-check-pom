<project>
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.codemonstur</groupId>
    <artifactId>maven-check-pom</artifactId>
    <version>1.0.0</version>

    <packaging>maven-plugin</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>A maven plugin for checking that properties defined in a pom are still used</description>
    <url>https://github.com/codemonstur/maven-check-pom</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/codemonstur/maven-check-pom.git</connection>
        <developerConnection>scm:git:https://github.com/codemonstur/maven-check-pom.git</developerConnection>
        <url>https://github.com/codemonstur/maven-check-pom</url>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <id>codemonstur</id>
            <name>Jurgen Voorneveld</name>
            <email>jegvoorneveld@gmail.com</email>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven.compiler.release>17</maven.compiler.release>

        <version.library.maven>3.9.6</version.library.maven>
        <version.library.maven-annotations>3.13.1</version.library.maven-annotations>

        <version.plugin.check-cves>1.2.0</version.plugin.check-cves>
        <version.plugin.check-license>1.5.0</version.plugin.check-license>
        <version.plugin.codegrade>0.2.0</version.plugin.codegrade>
        <version.plugin.gpg>3.2.8</version.plugin.gpg>
        <version.plugin.javadoc>3.12.0</version.plugin.javadoc>
        <version.plugin.plugin>3.13.1</version.plugin.plugin>
        <version.plugin.publish>0.12.0</version.plugin.publish>
        <version.plugin.source>3.4.0</version.plugin.source>
        <version.plugin.surefire>3.5.5</version.plugin.surefire>
            <version.library.pitest-junit5>1.2.3</version.library.pitest-junit5>
        <version.plugin.pitest>1.30.1</version.plugin.pitest>
</properties>

    <dependencies>

        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${version.library.maven}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${version.library.maven}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${version.library.maven-annotations}</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${version.plugin.surefire}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${version.plugin.plugin}</version>
                <configuration>
                    <goalPrefix>hcp</goalPrefix>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${version.plugin.source}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${version.plugin.javadoc}</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>deploy</phase>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>${version.plugin.gpg}</version>
                <configuration>
                    <passphrase>${gpg.passphrase}</passphrase>
                </configuration>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals><goal>sign</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${version.plugin.publish}</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>

        <profile>
            <id>licenses</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>maven-check-license</artifactId>
                        <version>${version.plugin.check-license}</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includeTestDependencies>true</includeTestDependencies>
                            <rules>
                                <rule>name:regex:.*Apache.*</rule>
                                <rule>name:regex:.*MIT.*</rule>
                                <rule>name:regex:.*BSD.*</rule>
                                <rule>name:regex:.*Eclipse.*</rule>
                                <rule>name:regex:.*EPL.*</rule>
                                <rule>name:regex:.*LGPL.*</rule>
                                <rule>name:regex:.*GPL.*</rule>
                                <rule>name:regex:.*MPL.*</rule>
                                <rule>name:regex:.*CDDL.*</rule>
                                <rule>name:regex:.*Public Domain.*</rule>
                                <rule>name:regex:.*WTFPL.*</rule>
                                <rule>name:regex:.*SAX.*</rule>
                                <rule>name:regex:.*W3C.*</rule>
                                <rule>name:regex:.*Indiana.*</rule>
                                <rule>name:regex:.*Common Public.*</rule>
                                <rule>name:regex:.*Similar to Apache.*</rule>
                                <rule>name:regex:.*Lesser General Public.*</rule>
                                <rule>name:regex:.*Mozilla Public License.*</rule>
                                <rule>name:regex:.*GNU General Public.*</rule>
                                <rule>name:regex:.*CC0.*</rule>
                                <rule>name:regex:.*Creative Commons.*</rule>
                                <rule>name:regex:.*Affero.*</rule>
                                <rule>name:regex:.*AGPL.*</rule>
                                <rule>name:regex:.*EDL.*</rule>
                                <rule>name:regex:.*Bouncy Castle.*</rule>
                                <rule>name:regex:.*Unicode.*</rule>
                                <rule>name:regex:.*ICU.*</rule>
                            </rules>
                        
                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <profile>
            <id>vulnerabilities</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>maven-check-cves</artifactId>
                        <version>${version.plugin.check-cves}</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includeTestDependencies>true</includeTestDependencies>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>codequality</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>codegrade-maven-plugin</artifactId>
                        <version>${version.plugin.codegrade}</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>

            <profile>
            <id>mutation</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${version.plugin.pitest}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${version.library.pitest-junit5}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <phase>test</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>
</profiles>

</project>
